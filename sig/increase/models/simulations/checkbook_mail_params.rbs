module Increase
  module Models
    module Simulations
      type checkbook_mail_params =
        { checkbook_id: String } & Increase::Internal::Type::request_parameters

      class CheckbookMailParams < Increase::Internal::Type::BaseModel
        extend Increase::Internal::Type::RequestParameters::Converter
        include Increase::Internal::Type::RequestParameters

        attr_accessor checkbook_id: String

        def initialize: (
          checkbook_id: String,
          ?request_options: Increase::request_opts
        ) -> void

        def to_hash: -> {
          checkbook_id: String,
          request_options: Increase::RequestOptions
        }
      end
    end
  end
end
