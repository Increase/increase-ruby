      type creditor =
        {
          account_name: String?,
          address: Increase::InboundRealTimePaymentsRequestForPayment::Creditor::Address,
          name: String
        }

      class Creditor < Increase::Internal::Type::BaseModel
        attr_accessor account_name: String?

        attr_accessor address: Increase::InboundRealTimePaymentsRequestForPayment::Creditor::Address

        attr_accessor name: String

        def initialize: (
          account_name: String?,
          address: Increase::InboundRealTimePaymentsRequestForPayment::Creditor::Address,
          name: String
        ) -> void

        def to_hash: -> {
          account_name: String?,
          address: Increase::InboundRealTimePaymentsRequestForPayment::Creditor::Address,
          name: String
        }

        type address =
          {
            :address_line2 => String?,
            building_number: String?,
            city: String?,
            country: String?,
            postal_code: String?,
            state: String?,
            street_name: String?
          }

        class Address < Increase::Internal::Type::BaseModel
          attr_accessor address_line2: String?

          attr_accessor building_number: String?

          attr_accessor city: String?

          attr_accessor country: String?

          attr_accessor postal_code: String?

          attr_accessor state: String?

          attr_accessor street_name: String?

          def initialize: (
            address_line2: String?,
            building_number: String?,
            city: String?,
            country: String?,
            postal_code: String?,
            state: String?,
            street_name: String?
