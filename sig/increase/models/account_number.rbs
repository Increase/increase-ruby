module Increase
  module Models
    type account_number =
      {
        id: String,
        account_id: String,
        account_number: String,
        created_at: Time,
        idempotency_key: String?,
        inbound_ach_debits: Increase::Models::AccountNumber::inbound_ach_debits,
        name: String,
        routing_number: String,
        status: Increase::Models::AccountNumber::status,
        type: Increase::Models::AccountNumber::type_,
        unregistered_inbound_checks: Increase::Models::AccountNumber::unregistered_inbound_checks
      }

    class AccountNumber < Increase::Internal::Type::BaseModel
      attr_accessor id: String

      attr_accessor account_id: String

      attr_accessor account_number: String

      attr_accessor created_at: Time

      attr_accessor idempotency_key: String?

      attr_accessor inbound_ach_debits: Increase::Models::AccountNumber::inbound_ach_debits

      attr_accessor name: String

      attr_accessor routing_number: String

      attr_accessor status: Increase::Models::AccountNumber::status

      attr_accessor type: Increase::Models::AccountNumber::type_

      attr_accessor unregistered_inbound_checks: Increase::Models::AccountNumber::unregistered_inbound_checks

      def initialize: (
        id: String,
        account_id: String,
        account_number: String,
        created_at: Time,
        idempotency_key: String?,
        inbound_ach_debits: Increase::Models::AccountNumber::inbound_ach_debits,
        name: String,
        routing_number: String,
        status: Increase::Models::AccountNumber::status,
        type: Increase::Models::AccountNumber::type_,
        unregistered_inbound_checks: Increase::Models::AccountNumber::unregistered_inbound_checks
      ) -> void

      def to_hash: -> {
        id: String,
        account_id: String,
        account_number: String,
        created_at: Time,
        idempotency_key: String?,
        inbound_ach_debits: Increase::Models::AccountNumber::inbound_ach_debits,
        name: String,
        routing_number: String,
        status: Increase::Models::AccountNumber::status,
        type: Increase::Models::AccountNumber::type_,
        unregistered_inbound_checks: Increase::Models::AccountNumber::unregistered_inbound_checks
      }

      type inbound_ach_debits = :allowed | :blocked

      module InboundACHDebits
        extend Increase::Internal::Type::Enum

        # ACH Debits are allowed.
        ALLOWED: :allowed

        # ACH Debits are blocked. Received debits will be declined and returned with code `R20` (non-transaction account).
        BLOCKED: :blocked

        def self?.values: -> ::Array[Increase::Models::AccountNumber::inbound_ach_debits]
      end

      type status = :active | :disabled | :canceled

      module Status
        extend Increase::Internal::Type::Enum

        # The account number is active.
        ACTIVE: :active

        # The account number is temporarily disabled.
        DISABLED: :disabled

        # The account number is permanently disabled.
        CANCELED: :canceled

        def self?.values: -> ::Array[Increase::Models::AccountNumber::status]
      end

      type type_ = :account_number

      module Type
        extend Increase::Internal::Type::Enum

        ACCOUNT_NUMBER: :account_number

        def self?.values: -> ::Array[Increase::Models::AccountNumber::type_]
      end

      type unregistered_inbound_checks = :allowed | :blocked

      module UnregisteredInboundChecks
        extend Increase::Internal::Type::Enum

        # Accept all Inbound Check Deposits, even if they are not associated with a Check Transfer or Checkbook Check.
        ALLOWED: :allowed

        # Only accept Inbound Check Deposits if they can be matched to a Check Transfer or Checkbook Check.
        BLOCKED: :blocked

        def self?.values: -> ::Array[Increase::Models::AccountNumber::unregistered_inbound_checks]
      end
    end
  end
end
