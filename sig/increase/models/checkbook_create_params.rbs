module Increase
  module Models
    type checkbook_create_params =
      {
        account_number_id: String,
        mailing_address: Increase::CheckbookCreateParams::MailingAddress,
        payer: ::Array[Increase::CheckbookCreateParams::Payer],
        style: Increase::Models::CheckbookCreateParams::style
      }
      & Increase::Internal::Type::request_parameters

    class CheckbookCreateParams < Increase::Internal::Type::BaseModel
      extend Increase::Internal::Type::RequestParameters::Converter
      include Increase::Internal::Type::RequestParameters

      attr_accessor account_number_id: String

      attr_accessor mailing_address: Increase::CheckbookCreateParams::MailingAddress

      attr_accessor payer: ::Array[Increase::CheckbookCreateParams::Payer]

      attr_accessor style: Increase::Models::CheckbookCreateParams::style

      def initialize: (
        account_number_id: String,
        mailing_address: Increase::CheckbookCreateParams::MailingAddress,
        payer: ::Array[Increase::CheckbookCreateParams::Payer],
        style: Increase::Models::CheckbookCreateParams::style,
        ?request_options: Increase::request_opts
      ) -> void

      def to_hash: -> {
        account_number_id: String,
        mailing_address: Increase::CheckbookCreateParams::MailingAddress,
        payer: ::Array[Increase::CheckbookCreateParams::Payer],
        style: Increase::Models::CheckbookCreateParams::style,
        request_options: Increase::RequestOptions
      }

      type mailing_address =
        {
          city: String,
          :line1 => String,
          name: String,
          postal_code: String,
          state: String,
          :line2 => String
        }

      class MailingAddress < Increase::Internal::Type::BaseModel
        attr_accessor city: String

        attr_accessor line1: String

        attr_accessor name: String

        attr_accessor postal_code: String

        attr_accessor state: String

        attr_reader line2: String?

        def line2=: (String) -> String

        def initialize: (
          city: String,
          line1: String,
          name: String,
          postal_code: String,
          state: String,
          ?line2: String
        ) -> void

        def to_hash: -> {
          city: String,
          :line1 => String,
          name: String,
          postal_code: String,
          state: String,
          :line2 => String
        }
      end

      type payer = { contents: String }

      class Payer < Increase::Internal::Type::BaseModel
        attr_accessor contents: String

        def initialize: (contents: String) -> void

        def to_hash: -> { contents: String }
      end

      type style = :top_tear_pad | :three_ring_binder

      module Style
        extend Increase::Internal::Type::Enum

        # A 3x6 inch pad of 25 checks, each torn off along a perforation at the top.
        TOP_TEAR_PAD: :top_tear_pad

        # A half-inch three-ring binder holding 75 pages of checks with 3 checks per page.
        THREE_RING_BINDER: :three_ring_binder

        def self?.values: -> ::Array[Increase::Models::CheckbookCreateParams::style]
      end
    end
  end
end
