module Increase
  module Models
    type checkbook_check_list_params =
      {
        account_number_id: String,
        check_number: Integer,
        checkbook_id: String,
        cursor: String,
        limit: Integer
      }
      & Increase::Internal::Type::request_parameters

    class CheckbookCheckListParams < Increase::Internal::Type::BaseModel
      extend Increase::Internal::Type::RequestParameters::Converter
      include Increase::Internal::Type::RequestParameters

      attr_reader account_number_id: String?

      def account_number_id=: (String) -> String

      attr_reader check_number: Integer?

      def check_number=: (Integer) -> Integer

      attr_reader checkbook_id: String?

      def checkbook_id=: (String) -> String

      attr_reader cursor: String?

      def cursor=: (String) -> String

      attr_reader limit: Integer?

      def limit=: (Integer) -> Integer

      def initialize: (
        ?account_number_id: String,
        ?check_number: Integer,
        ?checkbook_id: String,
        ?cursor: String,
        ?limit: Integer,
        ?request_options: Increase::request_opts
      ) -> void

      def to_hash: -> {
        account_number_id: String,
        check_number: Integer,
        checkbook_id: String,
        cursor: String,
        limit: Integer,
        request_options: Increase::RequestOptions
      }
    end
  end
end
