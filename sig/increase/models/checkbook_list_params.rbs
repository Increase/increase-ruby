module Increase
  module Models
    type checkbook_list_params =
      {
        account_number_id: String,
        cursor: String,
        idempotency_key: String,
        limit: Integer,
        status: Increase::CheckbookListParams::Status
      }
      & Increase::Internal::Type::request_parameters

    class CheckbookListParams < Increase::Internal::Type::BaseModel
      extend Increase::Internal::Type::RequestParameters::Converter
      include Increase::Internal::Type::RequestParameters

      attr_reader account_number_id: String?

      def account_number_id=: (String) -> String

      attr_reader cursor: String?

      def cursor=: (String) -> String

      attr_reader idempotency_key: String?

      def idempotency_key=: (String) -> String

      attr_reader limit: Integer?

      def limit=: (Integer) -> Integer

      attr_reader status: Increase::CheckbookListParams::Status?

      def status=: (
        Increase::CheckbookListParams::Status
      ) -> Increase::CheckbookListParams::Status

      def initialize: (
        ?account_number_id: String,
        ?cursor: String,
        ?idempotency_key: String,
        ?limit: Integer,
        ?status: Increase::CheckbookListParams::Status,
        ?request_options: Increase::request_opts
      ) -> void

      def to_hash: -> {
        account_number_id: String,
        cursor: String,
        idempotency_key: String,
        limit: Integer,
        status: Increase::CheckbookListParams::Status,
        request_options: Increase::RequestOptions
      }

      type status =
        { in_: ::Array[Increase::Models::CheckbookListParams::Status::in_] }

      class Status < Increase::Internal::Type::BaseModel
        attr_reader in_: ::Array[Increase::Models::CheckbookListParams::Status::in_]?

        def in_=: (
          ::Array[Increase::Models::CheckbookListParams::Status::in_]
        ) -> ::Array[Increase::Models::CheckbookListParams::Status::in_]

        def initialize: (
          ?in_: ::Array[Increase::Models::CheckbookListParams::Status::in_]
        ) -> void

        def to_hash: -> {
          in_: ::Array[Increase::Models::CheckbookListParams::Status::in_]
        }

        type in_ = :pending_submission | :pending_mailing | :mailed | :stopped

        module In
          extend Increase::Internal::Type::Enum

          # The Checkbook is pending submission to the printer.
          PENDING_SUBMISSION: :pending_submission

          # The Checkbook has been submitted to the printer and is pending mailing.
          PENDING_MAILING: :pending_mailing

          # The Checkbook has been mailed.
          MAILED: :mailed

          # The Checkbook has been stopped and its checks can no longer be deposited.
          STOPPED: :stopped

          def self?.values: -> ::Array[Increase::Models::CheckbookListParams::Status::in_]
        end
      end
    end
  end
end
