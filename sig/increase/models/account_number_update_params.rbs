      }
      & Increase::Internal::Type::request_parameters

    class AccountNumberUpdateParams < Increase::Internal::Type::BaseModel
      extend Increase::Internal::Type::RequestParameters::Converter
      include Increase::Internal::Type::RequestParameters

      attr_accessor account_number_id: String

      attr_reader inbound_ach_debits: Increase::Models::AccountNumberUpdateParams::inbound_ach_debits?

      def inbound_ach_debits=: (
