module Increase
  module Models
    type real_time_payments_transfer_create_params =
      {
        amount: Integer,
        creditor_name: String,
        source_account_number_id: String,
        unstructured_remittance_information: String,
        account_number: String,
        debtor_address: Increase::RealTimePaymentsTransferCreateParams::DebtorAddress,
        debtor_name: String,
        external_account_id: String,
        inbound_real_time_payments_request_for_payment_id: String,
        require_approval: bool,
        routing_number: String,
        ultimate_creditor_name: String,
        ultimate_debtor_name: String
      }
      & Increase::Internal::Type::request_parameters

    class RealTimePaymentsTransferCreateParams < Increase::Internal::Type::BaseModel
      extend Increase::Internal::Type::RequestParameters::Converter
      include Increase::Internal::Type::RequestParameters

      attr_accessor amount: Integer

      attr_accessor creditor_name: String

      attr_accessor source_account_number_id: String

      attr_accessor unstructured_remittance_information: String

      attr_reader account_number: String?

      def account_number=: (String) -> String

      attr_reader debtor_address: Increase::RealTimePaymentsTransferCreateParams::DebtorAddress?

      def debtor_address=: (
        Increase::RealTimePaymentsTransferCreateParams::DebtorAddress
      ) -> Increase::RealTimePaymentsTransferCreateParams::DebtorAddress

      attr_reader debtor_name: String?

      def debtor_name=: (String) -> String

      attr_reader external_account_id: String?

      def external_account_id=: (String) -> String

      attr_reader inbound_real_time_payments_request_for_payment_id: String?

      def inbound_real_time_payments_request_for_payment_id=: (String) -> String

      attr_reader require_approval: bool?

      def require_approval=: (bool) -> bool

      attr_reader routing_number: String?

      def routing_number=: (String) -> String

      attr_reader ultimate_creditor_name: String?

      def ultimate_creditor_name=: (String) -> String

      attr_reader ultimate_debtor_name: String?

      def ultimate_debtor_name=: (String) -> String

      def initialize: (
        amount: Integer,
        creditor_name: String,
        source_account_number_id: String,
        unstructured_remittance_information: String,
        ?account_number: String,
        ?debtor_address: Increase::RealTimePaymentsTransferCreateParams::DebtorAddress,
        ?debtor_name: String,
        ?external_account_id: String,
        ?inbound_real_time_payments_request_for_payment_id: String,
        ?require_approval: bool,
        ?routing_number: String,
        ?ultimate_creditor_name: String,
        ?ultimate_debtor_name: String,
        ?request_options: Increase::request_opts
      ) -> void

      def to_hash: -> {
        amount: Integer,
        creditor_name: String,
        source_account_number_id: String,
        unstructured_remittance_information: String,
        account_number: String,
        debtor_address: Increase::RealTimePaymentsTransferCreateParams::DebtorAddress,
        debtor_name: String,
        external_account_id: String,
        inbound_real_time_payments_request_for_payment_id: String,
        require_approval: bool,
        routing_number: String,
        ultimate_creditor_name: String,
        ultimate_debtor_name: String,
        request_options: Increase::RequestOptions
      }

      type debtor_address =
        {
          city: String,
          country: String,
          postal_code: String,
          state: String,
          street_name: String,
          :address_line2 => String,
          building_number: String
        }

      class DebtorAddress < Increase::Internal::Type::BaseModel
        attr_accessor city: String

        attr_accessor country: String

        attr_accessor postal_code: String

        attr_accessor state: String

        attr_accessor street_name: String

        attr_reader address_line2: String?

        def address_line2=: (String) -> String

        attr_reader building_number: String?

        def building_number=: (String) -> String

        def initialize: (
          city: String,
          country: String,
          postal_code: String,
          state: String,
          street_name: String,
          ?address_line2: String,
          ?building_number: String
        ) -> void

        def to_hash: -> {
          city: String,
          country: String,
          postal_code: String,
          state: String,
          street_name: String,
          :address_line2 => String,
          building_number: String
        }
      end
    end
  end
end
