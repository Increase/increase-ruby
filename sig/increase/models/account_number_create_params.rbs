module Increase
  module Models
    type account_number_create_params =
      {
        account_id: String,
        name: String,
        inbound_ach_debits: Increase::Models::AccountNumberCreateParams::inbound_ach_debits,
        unregistered_inbound_checks: Increase::Models::AccountNumberCreateParams::unregistered_inbound_checks
      }
      & Increase::Internal::Type::request_parameters

    class AccountNumberCreateParams < Increase::Internal::Type::BaseModel
      extend Increase::Internal::Type::RequestParameters::Converter
      include Increase::Internal::Type::RequestParameters

      attr_accessor account_id: String

      attr_accessor name: String

      attr_reader inbound_ach_debits: Increase::Models::AccountNumberCreateParams::inbound_ach_debits?

      def inbound_ach_debits=: (
        Increase::Models::AccountNumberCreateParams::inbound_ach_debits
      ) -> Increase::Models::AccountNumberCreateParams::inbound_ach_debits

      attr_reader unregistered_inbound_checks: Increase::Models::AccountNumberCreateParams::unregistered_inbound_checks?

      def unregistered_inbound_checks=: (
        Increase::Models::AccountNumberCreateParams::unregistered_inbound_checks
      ) -> Increase::Models::AccountNumberCreateParams::unregistered_inbound_checks

      def initialize: (
        account_id: String,
        name: String,
        ?inbound_ach_debits: Increase::Models::AccountNumberCreateParams::inbound_ach_debits,
        ?unregistered_inbound_checks: Increase::Models::AccountNumberCreateParams::unregistered_inbound_checks,
        ?request_options: Increase::request_opts
      ) -> void

      def to_hash: -> {
        account_id: String,
        name: String,
        inbound_ach_debits: Increase::Models::AccountNumberCreateParams::inbound_ach_debits,
        unregistered_inbound_checks: Increase::Models::AccountNumberCreateParams::unregistered_inbound_checks,
        request_options: Increase::RequestOptions
      }

      type inbound_ach_debits = :allowed | :blocked

      module InboundACHDebits
        extend Increase::Internal::Type::Enum

        # ACH Debits are allowed.
        ALLOWED: :allowed

        # ACH Debits are blocked. Received debits will be declined and returned with code `R20` (non-transaction account).
        BLOCKED: :blocked

        def self?.values: -> ::Array[Increase::Models::AccountNumberCreateParams::inbound_ach_debits]
      end

      type unregistered_inbound_checks = :allowed | :blocked

      module UnregisteredInboundChecks
        extend Increase::Internal::Type::Enum

        # Accept all Inbound Check Deposits, even if they are not associated with a Check Transfer or Checkbook Check.
        ALLOWED: :allowed

        # Only accept Inbound Check Deposits if they can be matched to a Check Transfer or Checkbook Check.
        BLOCKED: :blocked

        def self?.values: -> ::Array[Increase::Models::AccountNumberCreateParams::unregistered_inbound_checks]
      end
    end
  end
