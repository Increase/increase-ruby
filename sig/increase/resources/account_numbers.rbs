module Increase
  module Resources
    class AccountNumbers
      def create: (
        account_id: String,
        name: String,
        ?inbound_ach_debits: Increase::Models::AccountNumberCreateParams::inbound_ach_debits,
        ?unregistered_inbound_checks: Increase::Models::AccountNumberCreateParams::unregistered_inbound_checks,
        ?request_options: Increase::request_opts
      ) -> Increase::AccountNumber

      def retrieve: (
        String account_number_id,
        ?request_options: Increase::request_opts
      ) -> Increase::AccountNumber

      def update: (
        String account_number_id,
        ?inbound_ach_debits: Increase::Models::AccountNumberUpdateParams::inbound_ach_debits,
        ?name: String,
        ?status: Increase::Models::AccountNumberUpdateParams::status,
        ?unregistered_inbound_checks: Increase::Models::AccountNumberUpdateParams::unregistered_inbound_checks,
        ?request_options: Increase::request_opts
      ) -> Increase::AccountNumber

      def list: (
        ?account_id: String,
        ?created_at: Increase::AccountNumberListParams::CreatedAt,
        ?cursor: String,
        ?idempotency_key: String,
        ?inbound_ach_debits: Increase::AccountNumberListParams::InboundACHDebits,
        ?limit: Integer,
        ?status: Increase::AccountNumberListParams::Status,
        ?request_options: Increase::request_opts
      ) -> Increase::Internal::Page[Increase::AccountNumber]

      def initialize: (client: Increase::Client) -> void
    end
  end
end
