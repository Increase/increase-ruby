module Increase
  module Resources
    class CheckbookChecks
      def retrieve: (
        String checkbook_check_id,
        ?request_options: Increase::request_opts
      ) -> Increase::CheckbookCheck

      def list: (
        ?account_number_id: String,
        ?check_number: Integer,
        ?checkbook_id: String,
        ?cursor: String,
        ?limit: Integer,
        ?request_options: Increase::request_opts
      ) -> Increase::Internal::Page[Increase::CheckbookCheck]

      def stop: (
        String checkbook_check_id,
        ?request_options: Increase::request_opts
      ) -> Increase::CheckbookCheck

      def initialize: (client: Increase::Client) -> void
    end
  end
end
